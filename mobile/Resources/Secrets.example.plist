<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Janarym iOS secrets template.

  Copy this file to Secrets.plist (same folder) and fill in your own values.
  Secrets.plist is git-ignored and must never be committed.

  OPENAI_PROXY_URL      URL of the deployed Cloudflare Worker (backend/workers/openai-proxy).
                        The app has no OpenAI key of its own: every AI call goes through this
                        proxy, authenticated with the signed-in user's Firebase ID token.
  ESP32_STREAM_TOKEN    Shared secret for the ESP32-CAM. Must match STREAM_AUTH_TOKEN in
                        firmware/include/secrets.h. Generate with `openssl rand -hex 32`.
  YANDEX_MAPKIT_API_KEY MapKit key for the navigation mode. Optional — leave empty to disable.
-->
<plist version="1.0">
<dict>
	<key>OPENAI_PROXY_URL</key>
	<string>https://your-worker-name.your-subdomain.workers.dev</string>
	<key>ESP32_STREAM_TOKEN</key>
	<string>your-long-random-stream-token</string>
	<key>YANDEX_MAPKIT_API_KEY</key>
	<string></string>
</dict>
</plist>
