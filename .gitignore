# ─────────────────────────────────────────────────────────────
# Secrets — never commit real keys
# ─────────────────────────────────────────────────────────────
Secrets.plist
**/Secrets.plist
!**/Secrets.example.plist

GoogleService-Info.plist
**/GoogleService-Info.plist

# Firmware secrets (Wi-Fi credentials, Firebase auth, stream token)
firmware/include/secrets.h
firmware/src/secrets.h
!firmware/include/secrets.h.example

# Environment files
.env
.env.*
!.env.example

# Cloudflare Worker secrets and local state
**/.dev.vars
!**/.dev.vars.example
**/.wrangler/
backend/workers/**/.dev.vars
backend/workers/**/.wrangler/

# Firebase service accounts / admin credentials
**/serviceAccountKey*.json
**/*-firebase-adminsdk-*.json
**/service-account*.json

# Signing material
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
*.pem

# ─────────────────────────────────────────────────────────────
# Xcode
# ─────────────────────────────────────────────────────────────
# The .xcodeproj is generated by ./generate_xcodeproj.py — do not commit it.
*.xcodeproj
*.xcworkspace
**/xcuserdata/
**/xcshareddata/IDEWorkspaceChecks.plist
build/
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip
*.hmap
*.moved-aside
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# Swift Package Manager
.build/
Packages/
Package.pins
Package.resolved

# CocoaPods (if ever used)
Pods/

# ─────────────────────────────────────────────────────────────
# Firmware (PlatformIO)
# ─────────────────────────────────────────────────────────────
firmware/.pio/
.pio/
.pioenvs/
.piolibdeps/

# ─────────────────────────────────────────────────────────────
# Backend (Firebase + Cloudflare Workers)
# ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
backend/functions/lib/
functions/lib/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
.firebase/

# ─────────────────────────────────────────────────────────────
# Python (training / tooling)
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
venv/
.venv/

# ─────────────────────────────────────────────────────────────
# Editors, tooling, OS
# ─────────────────────────────────────────────────────────────
.claude/
.agent/
.vscode/
.idea/
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*.swp
*~
