// ── Janarym ESP32-CAM Secrets Template ───────────────────────
// Copy this file to secrets.h and fill in your values.
// NEVER commit secrets.h to version control.

#pragma once

// Wi-Fi credentials
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// Firebase credentials
#define API_KEY "your-firebase-web-api-key"
#define STORAGE_BUCKET "your-project-id.firebasestorage.app"
#define DATABASE_URL "https://your-project-id-default-rtdb.firebaseio.com/"
#define USER_EMAIL "camera-device-user@example.com"
#define USER_PASSWORD "your-device-password"

// Firebase Cloud Function that accepts raw JPEG bytes from the ESP32-CAM
#define FIREBASE_UPLOAD_URL "https://us-central1-your-project-id.cloudfunctions.net/uploadEspSnapshot"

// Shared secret required by /stream and /snapshot. Generate a long random
// string (e.g. `openssl rand -hex 32`) and put the same value into the iOS
// app's Secrets.plist as ESP32_STREAM_TOKEN.
#define STREAM_AUTH_TOKEN "your-long-random-stream-token"
